<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Run.MainPage"
             BackgroundColor="#FAFBFD">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Header -->
            <Label Text="🧭 Select Your Training Plan"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2A2E3D" />

            <!-- Distance Picker -->
            <Frame BackgroundColor="white"
                   CornerRadius="16"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="#D0D5DD">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Distance"
                           FontSize="16"
                           TextColor="#6B7280"
                           FontAttributes="Bold" />
                    <Picker Title="Choose Distance"
                            ItemsSource="{Binding Distances}"
                            SelectedItem="{Binding SelectedDistance}"
                            FontSize="16"
                            TextColor="#1F2937"
                            BackgroundColor="White" />
                </VerticalStackLayout>
            </Frame>

            <!-- Level Picker -->
            <Frame BackgroundColor="white"
                   CornerRadius="16"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="#D0D5DD">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Level"
                           FontSize="16"
                           TextColor="#6B7280"
                           FontAttributes="Bold" />
                    <Picker Title="Choose Level"
                            ItemsSource="{Binding Levels}"
                            SelectedItem="{Binding SelectedLevel}"
                            FontSize="16"
                            TextColor="#1F2937"
                            BackgroundColor="White" />
                </VerticalStackLayout>
            </Frame>

            <!-- Summary Section -->
            <Frame BackgroundColor="#FFFFFF"
                   CornerRadius="16"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="#E5E7EB">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Plan Summary"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#3B82F6" />

                    <HorizontalStackLayout>
                        <Label Text="Duration (Weeks):"
                               FontSize="14"
                               TextColor="#6B7280" />
                        <Label Text="{Binding SelectedPlan.DurationWeeks}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#10B981"
                               HorizontalOptions="EndAndExpand" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Focus:"
                               FontSize="14"
                               TextColor="#6B7280" />
                        <Label Text="{Binding SelectedPlan.Focus}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#3B82F6"
                               HorizontalOptions="EndAndExpand" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Weekly Plan List -->
            <Label Text="Weekly Breakdown"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#1E3A8A"
                   Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding SelectedPlan.Weeks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White"
                               CornerRadius="14"
                               Padding="14"
                               BorderColor="#E0E7FF"
                               HasShadow="True"
                               Margin="0,6">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding WeekTitle}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#1E40AF" />
                                <Label Text="{Binding Tips}"
                                       FontSize="14"
                                       TextColor="#6B7280" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Download PDF" Command="{Binding ExportToPdfCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
