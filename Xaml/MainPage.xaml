<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Run.Controls"
             x:Class="Run.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F0F6FF">
    <ScrollView>
        <VerticalStackLayout>

            <controls:TopBar 
                         ShowBackButton="False" />
            <VerticalStackLayout Padding="24" 
                             Spacing="20">


                <Label  Text="🧭 Select Your Training Plan"
                    FontSize="26"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="#1E3A8A" />

                <!-- Distance Picker -->
                <Frame BackgroundColor="White"
                    CornerRadius="16"
                    Padding="16"
                    HasShadow="True"
                    BorderColor="#BFDBFE">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Choose Distance"
                             FontSize="16"
                             TextColor="#2563EB"
                             FontAttributes="Bold" />

                        <Frame CornerRadius="8"
                             Padding="0"
                             HasShadow="False"
                             HeightRequest="44"
                             BorderColor="#3B82F6"
                             BackgroundColor="White">

                            <Picker Title=""
                                  ItemsSource="{Binding Distances}"
                                  SelectedItem="{Binding SelectedDistance}"
                                  FontSize="16"
                                  TextColor="#1E40AF"
                                  BackgroundColor="Transparent" />
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Level Picker -->
                <Frame BackgroundColor="White"
                     CornerRadius="16"
                     Padding="16"
                     HasShadow="True"
                     BorderColor="#BFDBFE">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Choose Level"
                             FontSize="16"
                             TextColor="#2563EB"
                             FontAttributes="Bold" />

                        <Frame CornerRadius="8"
                             Padding="0"
                             HasShadow="False"
                             HeightRequest="44"
                             BorderColor="#3B82F6"
                             BackgroundColor="White">

                            <Picker Title=""
                                ItemsSource="{Binding Levels}"
                                SelectedItem="{Binding SelectedLevel}"
                                FontSize="16"
                                TextColor="#1E40AF"
                                BackgroundColor="Transparent" />
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Plan Summary -->
                <Frame BackgroundColor="White"
                    CornerRadius="16"
                    Padding="16"
                    HasShadow="True"
                    BorderColor="#BFDBFE" 
                   IsVisible="{Binding IsFrameVisible}">
                    <VerticalStackLayout Spacing="6" >
                        <Label Text="📋 Plan Summary"
                             FontSize="18"
                             FontAttributes="Bold"
                             TextColor="#1D4ED8" />

                        <HorizontalStackLayout>
                            <Label Text="Duration (Weeks):"
                                FontSize="14"
                                TextColor="#6B7280" />
                            <Label Text="{Binding SelectedPlan.DurationWeeks}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#1E40AF"
                                HorizontalOptions="EndAndExpand" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Focus:"
                                FontSize="14"
                                TextColor="#6B7280" />
                            <Label Text="{Binding SelectedPlan.Focus}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#2563EB"
                                HorizontalOptions="EndAndExpand" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Weekly Plan List -->
                <Label Text="📆 Weekly Breakdown"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#1E3A8A"
                    Margin="0,10,0,0" IsVisible="{Binding IsFrameVisible}" />

                <!-- Export Button -->
                <Button Text="📥 Download PDF"
                    IsVisible="{Binding IsFrameVisible}"
                    Command="{Binding ExportToPdfCommand}"
                    BackgroundColor="#3B82F6"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    FontSize="16"
                    HeightRequest="48"
                    Margin="0,20,0,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
    
    
