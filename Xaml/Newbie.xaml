<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Run.Controls"
             xmlns:vm="clr-namespace:Run.ViewModels"
             x:Class="Run.Newbie"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <vm:NewbiePlanViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout>
            <!-- <controls:TopBar ShowBackButton="False" /> --> 

            <VerticalStackLayout Padding="24" Spacing="20">

                <!-- Header -->
                <Label Text="Start Your Running Journey"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                       HorizontalOptions="Center" />

                <!-- Goal Picker -->
                <Label Text="Select Your Goal"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                <Frame Padding="0" CornerRadius="12" HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                       BorderColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}"
                       HeightRequest="44">
                    <Picker ItemsSource="{Binding Goals}"
                            SelectedItem="{Binding Goal}"
                            Title=""
                            TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                            BackgroundColor="Transparent"
                            FontSize="16" />
                </Frame>

                <!-- Activity Level Picker -->
                <Label Text="Select Activity Level"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                <Frame Padding="0" CornerRadius="12" HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                       BorderColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}"
                       HeightRequest="44">
                    <Picker ItemsSource="{Binding ActivityLevels}"
                            SelectedItem="{Binding ActivityLevel}"
                            Title=""
                            TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                            BackgroundColor="Transparent"
                            FontSize="16" />
                </Frame>

                <!-- Days per Week Picker -->
                <Label Text="Select Days per Week"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                <Frame Padding="0" CornerRadius="12" HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                       BorderColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}"
                       HeightRequest="44">
                    <Picker ItemsSource="{Binding DaysPerWeekOptions}"
                            SelectedItem="{Binding DaysPerWeek}"
                            Title=""
                            TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                            BackgroundColor="Transparent"
                            FontSize="16" />
                </Frame>

                <!-- Run Style Picker -->
                <Label Text="Select Your Run Style"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                <Frame Padding="0" CornerRadius="12" HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                       BorderColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}"
                       HeightRequest="44">
                    <Picker ItemsSource="{Binding RunStyles}"
                            SelectedItem="{Binding RunStyle}"
                            Title=""
                            TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                            BackgroundColor="Transparent"
                            FontSize="16" />
                </Frame>

                <!-- Weight Input -->
                <Label Text="Enter Your Weight (kg)"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                <Entry Text="{Binding Weight}"
                       Placeholder="e.g., 70"
                       Keyboard="Numeric"
                       HeightRequest="44"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                       FontSize="16"
                       TextChanged="OnNumericEntryChanged" />

                <!-- Height Input -->
                <Label Text="Enter Your Height (cm)"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                <Entry Text="{Binding Height}"
                       Placeholder="e.g., 175"
                       Keyboard="Numeric"
                       HeightRequest="44"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                       FontSize="16"
                       TextChanged="OnNumericEntryChanged" />

                <!-- Generate Plan Button -->
                <Button Text="Generate Plan"
                        Command="{Binding LoadPlanCommand}"
                        Clicked="OnViewPlanClicked"
                        BackgroundColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                        TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="16"
                        HeightRequest="48"
                        Margin="0,20,0,0" />

                <!-- Weekly Plan Display -->
               
                <!-- Download Plan Button -->
                <Button x:Name="downloadnewbie"
                        Text="Download Plan"
                        Clicked="OnDownPlanClicked"
                        IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                        TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="16"
                        HeightRequest="48"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
