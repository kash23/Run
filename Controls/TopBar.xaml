<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Run.Controls.TopBar"
             x:Name="TopBarControl"
             HeightRequest="70">

    <Frame CornerRadius="16"
       HasShadow="True"
       Padding="0,0,0,0"
       Margin="10,15,10,0"
       BackgroundColor="#0F172A">

        <Grid ColumnDefinitions="*,Auto"
          Padding="20,0"
          VerticalOptions="Center">

            <!-- Left: Futuristic Name or Logo -->
            <Label Grid.Column="0"
               Text="{Binding UserName, Source={x:Reference TopBarControl}}"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#60A5FA"
               VerticalOptions="Center"
               HorizontalOptions="Start"
               TranslationY="1" />

            <!-- Right: Futuristic Logout Button -->
            <Button Grid.Column="1"
                Text="Logout"
                BackgroundColor="Transparent"
                TextColor="#93C5FD"
                FontSize="14"
                FontAttributes="Bold"
                Padding="0"
                VerticalOptions="Center"
                HorizontalOptions="End"
                Clicked="OnLogoutClicked">
                <Button.Shadow>
                    <Shadow Brush="#60A5FA" Offset="0,0" Radius="4" />
                </Button.Shadow>
            </Button>
        </Grid>
    </Frame>



</ContentView>
